+def _open_tmp(tmp):
+    # A planted symlink at the temporary name would carry the write out of the repository:
+    # drop whatever is there and create the file new, never following a link.
+    if os.path.lexists(tmp):
+        os.unlink(tmp)
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
+    return os.fdopen(os.open(tmp, flags, 0o666), "w", encoding="utf-8")
+
