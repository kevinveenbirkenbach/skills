[Unit]
Description=Agent Orchestrator resources: disks, CPU, RAM, swap, load, GPU and the queue, into the files the orchestrator reads

[Service]
Type=oneshot
Environment=PATH=/usr/bin:/bin
EnvironmentFile=%h/.local/share/kvb-orchestrator/.env
ExecStart=/usr/bin/env python3 %h/.local/share/kvb-orchestrator/client/resources.py sample --state ${KVB_ORCHESTRATOR_KEPT}/resources --council ${KVB_ORCHESTRATOR_COUNCIL} --proc /proc --sys /sys --queue ${KVB_ORCHESTRATOR_SKILLS}/kvb-org-queue/scripts/queue.py
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=300
